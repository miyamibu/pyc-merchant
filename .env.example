# Chain monitor worker settings
RPC_URLS=https://polygon-rpc.example.com,https://polygon-rpc-backup.example.com
RPC_URLS_1=https://ethereum-rpc.example.com
RPC_URLS_43114=https://avalanche-rpc.example.com
RPC_URLS_137=https://polygon-rpc.example.com,https://polygon-rpc-backup.example.com
