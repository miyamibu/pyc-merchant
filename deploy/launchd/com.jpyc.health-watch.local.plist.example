<?xml version="1.0" encoding="UTF-8"?>
<!--
  JPYC loopback health watcher template for the local_store_terminal topology
  on an in-store Mac. Runs every 60 seconds through the safe runner.

  Node is pinned to the EXACT absolute path below (note the space in
  "Application Support" - keep it verbatim). run-env-safe.mjs refuses to run
  under any other interpreter version:
    /Users/mimac/Library/Application Support/JPYC Terminal/runtime/node-v24.17.0-darwin-arm64/bin/node

  What the watcher does (deploy/launchd/targets/health-watch.mjs):
  - GET http://127.0.0.1:<APP_PORT>/healthz and require HTTP 200 + ok:true
    (loopback only; non-loopback APP_BIND_HOST values are rejected).
  - Open WORKER_STATE_DB_PATH read-only and fail when the chain worker state
    is stale (older than WORKER_STALE_SEC, default 180s), when rpc_count is
    missing, or when the checkpoint is missing.
  - Fail closed: any problem exits non-zero. It writes one JSON line per run
    to its launchd log files and NEVER delivers external alerts; operators or
    a separate on-call process must watch these logs / the exit status.

  Configuration comes from __REPO_DIR__/.env.production (chmod 0600 required)
  through deploy/launchd/run-env-safe.mjs; no secrets are printed.

  Replace __REPO_DIR__ and __LOG_DIR__ with real values.

  Install:   launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.jpyc.health-watch.local.plist
  Run now:   launchctl kickstart -k gui/$UID/com.jpyc.health-watch.local
  Status:    launchctl print gui/$UID/com.jpyc.health-watch.local
  Rollback:  launchctl bootout gui/$UID ~/Library/LaunchAgents/com.jpyc.health-watch.local.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jpyc.health-watch.local</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/mimac/Library/Application Support/JPYC Terminal/runtime/node-v24.17.0-darwin-arm64/bin/node</string>
    <string>__REPO_DIR__/deploy/launchd/run-env-safe.mjs</string>
    <string>--cwd</string>
    <string>__REPO_DIR__</string>
    <string>--env-file</string>
    <string>__REPO_DIR__/.env.production</string>
    <string>--allow-exec</string>
    <string>/Users/mimac/Library/Application Support/JPYC Terminal/runtime/node-v24.17.0-darwin-arm64/bin/node</string>
    <string>--</string>
    <string>deploy/launchd/targets/health-watch.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/health-watch.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/health-watch.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ExitTimeOut</key>
  <integer>30</integer>
</dict>
</plist>
