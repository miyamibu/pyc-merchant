{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jpyc-merchant-ops.local/schemas/device-pair-evidence.schema.json",
  "title": "Device Pair Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "git_commit",
    "environment",
    "origin",
    "enabled_chain_ids",
    "contract_address",
    "devices",
    "capabilities",
    "scenarios",
    "media",
    "operator_attestation",
    "reviewer_attestation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "release_id": { "type": "string", "minLength": 1 },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "environment": { "enum": ["staging", "production-like", "production"] },
    "origin": { "type": "string", "pattern": "^https://" },
    "enabled_chain_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "devices": { "type": "object" },
    "capabilities": { "type": "object" },
    "scenarios": { "type": "object" },
    "media": { "type": "array" },
    "operator_attestation": { "type": "object" },
    "reviewer_attestation": { "type": "object" }
  },
  "additionalProperties": true
}
