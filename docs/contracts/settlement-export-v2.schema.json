{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/settlement-export-v2.schema.json",
  "title": "Settlement Export Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_id",
    "export_run_id",
    "contract_version",
    "export_version",
    "business_date",
    "format",
    "generated_at",
    "output_path",
    "refund_manifest",
    "refund_totals",
    "metadata",
    "rows"
  ],
  "properties": {
    "export_id": { "type": "string", "minLength": 1 },
    "export_run_id": { "type": "string", "minLength": 1 },
    "contract_version": { "const": "settlement_export_v2" },
    "export_version": { "const": "v2" },
    "business_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "format": { "enum": ["json", "csv"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "output_path": { "type": "string", "minLength": 1 },
    "refund_manifest": {
      "type": "array",
      "items": { "$ref": "#/$defs/refundManifestEntry" }
    },
    "refund_totals": { "$ref": "#/$defs/refundTotals" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "refundReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refund_id",
        "refund_case_id",
        "review_case_id",
        "funding_lineage_id",
        "status",
        "refund_amount_jpyc_base",
        "refund_tx_hash",
        "refund_tx_log_index",
        "verified_at",
        "audit_log_refs"
      ],
      "properties": {
        "refund_id": { "type": "string", "minLength": 1 },
        "refund_case_id": { "type": ["string", "null"] },
        "review_case_id": { "type": ["string", "null"] },
        "funding_lineage_id": { "type": ["string", "null"] },
        "status": { "type": "string", "minLength": 1 },
        "refund_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_tx_hash": { "type": ["string", "null"] },
        "refund_tx_log_index": { "type": ["integer", "null"] },
        "verified_at": { "type": ["string", "null"] },
        "audit_log_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "refundSummary": {
      "type": "object",
      "required": [
        "refund_reference_status",
        "refund_reference_count",
        "refund_requested_amount_jpyc_base",
        "refund_reserved_amount_jpyc_base",
        "refund_succeeded_amount_jpyc_base",
        "refund_references"
      ],
      "properties": {
        "refund_reference_status": {
          "enum": ["none", "complete", "invoice_manifest_only"]
        },
        "refund_reference_count": { "type": "integer", "minimum": 0 },
        "refund_requested_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_reserved_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_succeeded_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/refundReference" }
        }
      }
    },
    "refundManifestEntry": {
      "allOf": [
        { "$ref": "#/$defs/refundSummary" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invoice_id",
            "primary_export_row_id",
            "primary_payment_session_id",
            "attribution",
            "refund_reference_status",
            "refund_reference_count",
            "refund_requested_amount_jpyc_base",
            "refund_reserved_amount_jpyc_base",
            "refund_succeeded_amount_jpyc_base",
            "refund_references"
          ],
          "properties": {
            "invoice_id": { "type": "string", "minLength": 1 },
            "primary_export_row_id": { "type": "string", "minLength": 1 },
            "primary_payment_session_id": { "type": ["string", "null"] },
            "attribution": { "const": "invoice_primary_row" },
            "refund_reference_status": {},
            "refund_reference_count": {},
            "refund_requested_amount_jpyc_base": {},
            "refund_reserved_amount_jpyc_base": {},
            "refund_succeeded_amount_jpyc_base": {},
            "refund_references": {}
          }
        }
      ]
    },
    "refundTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoice_count",
        "refund_reference_count",
        "refund_requested_amount_jpyc_base",
        "refund_reserved_amount_jpyc_base",
        "refund_succeeded_amount_jpyc_base"
      ],
      "properties": {
        "invoice_count": { "type": "integer", "minimum": 0 },
        "refund_reference_count": { "type": "integer", "minimum": 0 },
        "refund_requested_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_reserved_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_succeeded_amount_jpyc_base": { "type": "integer", "minimum": 0 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export_run_id",
        "contract_version",
        "export_version",
        "export_scope",
        "totals",
        "timezone",
        "period_start_utc",
        "period_end_utc",
        "row_count",
        "hash_scope"
      ],
      "properties": {
        "export_run_id": { "type": "string", "minLength": 1 },
        "contract_version": { "const": "settlement_export_v2" },
        "export_version": { "const": "v2" },
        "export_scope": { "const": "daily" },
        "totals": { "type": "object" },
        "timezone": { "type": "string", "minLength": 1 },
        "period_start_utc": { "type": "string", "format": "date-time" },
        "period_end_utc": { "type": "string", "format": "date-time" },
        "row_count": { "type": "integer", "minimum": 0 },
        "hash_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "json", "csv"],
          "properties": {
            "version": { "const": "settlement_export_v2_canonical_payload_without_content_hashes" },
            "json": { "type": "string", "minLength": 1 },
            "csv": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "export_reference",
        "settlement_id",
        "settlement_export_run_id",
        "settlement_export_row_id",
        "export_run_id",
        "export_version",
        "business_date",
        "store_id",
        "terminal_id",
        "operator_id",
        "invoice_id",
        "invoice_no",
        "checkout_session_id",
        "payment_session_id",
        "rail_type",
        "provider_code",
        "chain_id",
        "network",
        "token_contract",
        "recipient_address",
        "payment_attempt_ids",
        "primary_tx_hash",
        "primary_tx_log_index",
        "review_case_id",
        "review_reason_type",
        "review_status",
        "refund_request_id",
        "refund_tx_hash",
        "audit_log_refs",
        "external_sync_refs",
        "accounting_event_refs",
        "source_ledger_snapshot_hash",
        "invoice_amount_jpyc_base",
        "invoice_status",
        "accounting_status",
        "cash_recognition_status",
        "receivable_status",
        "onchain_cash_amount_jpyc_base",
        "provider_receivable_amount_jpyc_base",
        "exception_amount_jpyc_base",
        "refund_amount_jpyc_base",
        "refund_attribution",
        "refund_reference_status",
        "refund_reference_count",
        "refund_requested_amount_jpyc_base",
        "refund_reserved_amount_jpyc_base",
        "refund_succeeded_amount_jpyc_base",
        "refund_references",
        "void_amount_jpyc_base",
        "provider_payment_ref",
        "provider_settlement_ref",
        "onchain_transfer_ref",
        "evidence_hash",
        "payload_schema_version",
        "export_excluded_private_data",
        "created_at"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "export_reference": { "type": "string", "minLength": 1 },
        "settlement_id": { "type": ["string", "null"] },
        "settlement_export_run_id": { "type": "string", "minLength": 1 },
        "settlement_export_row_id": { "type": "string", "minLength": 1 },
        "export_run_id": { "type": "string", "minLength": 1 },
        "export_version": { "const": "v2" },
        "business_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "store_id": { "type": ["string", "null"] },
        "terminal_id": { "type": ["string", "null"] },
        "operator_id": { "type": ["string", "null"] },
        "invoice_id": { "type": "string", "minLength": 1 },
        "invoice_no": { "type": ["string", "null"] },
        "checkout_session_id": { "type": ["string", "null"] },
        "payment_session_id": { "type": ["string", "null"] },
        "rail_type": { "enum": ["wallet_direct", "provider_external"] },
        "provider_code": { "type": "string", "minLength": 1 },
        "chain_id": { "type": "string", "enum": ["1", "43114", "137"] },
        "network": { "type": "string", "enum": ["Ethereum Mainnet", "Avalanche C-Chain", "Polygon"] },
        "token_contract": {
          "type": "string",
          "pattern": "^0x[Ee]7[Cc]3[Dd]8[Cc]9[Aa]439[Ff][Ee][Dd][Ee]00[Dd]2600032[Dd]5[Dd][Bb]0[Bb][Ee]71[Cc]3[Cc]29$"
        },
        "recipient_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "payment_attempt_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "primary_tx_hash": { "type": ["string", "null"] },
        "primary_tx_log_index": { "type": ["integer", "null"] },
        "review_case_id": { "type": ["string", "null"] },
        "review_reason_type": { "type": ["string", "null"] },
        "review_status": { "type": ["string", "null"] },
        "refund_request_id": { "type": ["string", "null"] },
        "refund_tx_hash": { "type": ["string", "null"] },
        "audit_log_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "external_sync_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "accounting_event_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source_ledger_snapshot_hash": { "type": "string", "minLength": 1 },
        "invoice_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "invoice_status": { "type": "string", "minLength": 1 },
        "accounting_status": {
          "enum": [
            "onchain_cash_confirmed",
            "provider_receivable",
            "provider_settlement_pending",
            "provider_settled_unallocated",
            "exception_pending",
            "voided",
            "cancelled",
            "refunded_onchain",
            "provider_refunded"
          ]
        },
        "cash_recognition_status": { "enum": ["none", "onchain_confirmed", "batch_confirmed", "disputed"] },
        "receivable_status": { "enum": ["none", "provider_accepted", "provider_captured", "settlement_reported", "settlement_overdue", "disputed"] },
        "onchain_cash_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "provider_receivable_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "exception_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_attribution": { "enum": ["none", "invoice_primary", "invoice_manifest_only"] },
        "refund_reference_status": { "enum": ["none", "complete", "invoice_manifest_only"] },
        "refund_reference_count": { "type": "integer", "minimum": 0 },
        "refund_requested_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_reserved_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_succeeded_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "refund_references": { "type": "array", "items": { "$ref": "#/$defs/refundReference" } },
        "void_amount_jpyc_base": { "type": "integer", "minimum": 0 },
        "provider_payment_ref": { "type": ["string", "null"] },
        "provider_settlement_ref": { "type": ["string", "null"] },
        "onchain_transfer_ref": { "type": ["string", "null"] },
        "evidence_hash": { "type": "string", "minLength": 1 },
        "payload_schema_version": { "const": "settlement_export_v2" },
        "export_excluded_private_data": { "const": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
