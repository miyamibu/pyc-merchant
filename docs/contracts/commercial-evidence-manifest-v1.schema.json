{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/commercial-evidence-manifest-v1.schema.json",
  "title": "Commercial Evidence Manifest v1",
  "x-clock-skew-seconds": 60,
  "x-max-validity-seconds": 604800,
  "x-manual-cross-field-constraints": [
    "issued_at is before expires_at and validity is no more than 7 days"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "issued_at", "expires_at", "revocation_status", "artifacts", "signatures"],
  "properties": {
    "schema_version": { "const": "commercial_evidence_manifest_v1" },
    "release": { "$ref": "#/$defs/releaseFingerprint" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revocation_status": { "const": "valid" },
    "artifacts": {
      "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/artifact" }
    },
    "signatures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/signature" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "releaseFingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "commit", "source_hash", "app_image_digest", "environment_id"],
      "properties": {
        "release_id": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "source_hash": { "$ref": "#/$defs/sha256" },
        "app_image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "environment_id": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "path", "sha256", "media_type"],
      "properties": {
        "evidence_id": { "enum": ["EXT-001", "EXT-002", "EXT-003", "EXT-004", "POC-001", "POC-002", "POC-003", "PERF-001"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "const": "text/markdown" }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "encoding", "key_id", "signer_role", "public_key_pem", "signature_base64"],
      "properties": {
        "algorithm": { "const": "ed25519" }, "encoding": { "const": "base64" },
        "key_id": { "$ref": "#/$defs/sha256" }, "signer_role": { "const": "evidence_verifier" },
        "public_key_pem": { "type": "string", "minLength": 1 },
        "signature_base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/][AQgw]==$"
        }
      }
    }
  }
}
