# Non-secret production env completion template.
# Status: DRAFT / NOT A DEPLOYABLE .env.production
# Purpose: show the exact non-secret commercial-gate values and placeholders
# that a human operator must bind to real Secret Manager refs, signed approvals,
# public HTTPS policy URLs, and verified JPYC contract evidence.
#
# Do not copy this file as-is into production. Do not commit secret values.

APP_ENV=production
NODE_ENV=production
COMMERCIAL_GO_MODE=true
RELEASE_MODE=commercial

APP_HOST=https://pay.miyamibu.xyz
PAY_BASE_URL=https://pay.miyamibu.xyz
PUBLIC_BASE_URL=https://pay.miyamibu.xyz
CORS_ALLOW_ORIGINS=https://pay.miyamibu.xyz

# Secrets must come from Secret Manager or equivalent.
APP_SECRET=<secret-manager-ref:APP_SECRET>
SERVICE_INGEST_SECRET=<secret-manager-ref:SERVICE_INGEST_SECRET>
METRICS_SECRET=<secret-manager-ref:METRICS_SECRET>
REOWN_PROJECT_ID=<secret-manager-ref:REOWN_PROJECT_ID>

DB_PATH=./runtime/data/app.db
BACKUP_DIR=./runtime/backups
LOG_LEVEL=info

CHAIN_ID=137
TOKEN_SYMBOL=JPYC
TOKEN_DECIMALS=6
JPYC_BASE_UNIT_SCALE=1000000

# Official source found during preparation:
# https://corporate.jpyc.co.jp/news/posts/Issue_jpycv2
# Must still be approved internally and RPC-verified before use.
TOKEN_CONTRACT=0x431D5dfF03120AFA4bDf332c61A6e1766eF37BDB
APPROVED_JPYC_TOKEN_CONTRACT=0x431D5dfF03120AFA4bDf332c61A6e1766eF37BDB
JPYC_CONTRACT_APPROVAL_REF=<A5-JPYC-CONTRACT-APPROVAL-REF>

REQUIRED_CONFIRMATIONS=12
MIN_REQUIRED_CONFIRMATIONS=12
CONFIRMATIONS_POLICY_APPROVAL_REF=<A6-CONFIRMATIONS-POLICY-APPROVAL-REF>
MONITOR_BACKSCAN_BLOCKS=24
MIN_MONITOR_BACKSCAN_BLOCKS=24
BACKSCAN_POLICY_APPROVAL_REF=<A6-BACKSCAN-POLICY-APPROVAL-REF>
RPC_URLS=<secret-manager-ref:POLYGON_RPC_URLS>

TRUST_PROXY=true
PUBLIC_LINK_GRACE_SEC=86400
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
SESSION_TTL_SEC=43200
SERVICE_INGEST_ID=chain-monitor
SERVICE_AUTH_MAX_SKEW_SEC=300
SERVICE_AUTH_MAX_FUTURE_SEC=30
SERVICE_REPLAY_GUARD_TTL_SEC=86400
IDEMPOTENCY_TTL_SEC=604800
PIN_LOCKOUT_MAX_ATTEMPTS=5
PIN_LOCKOUT_SEC=900
WORKER_STALE_SEC=180
SSE_TOKEN_MAX_TTL_SEC=900

WALLET_ADAPTER_TYPE=reown
ENABLE_REOWN=true
WALLET_HELP_URL=https://walletconnect.com/
SUPPORTED_WALLETS=HashPort Wallet,WalletConnect,Injected Wallet
ENABLE_PUBLIC_PAYMENT_SIMULATION=false
DEMO_CONTROLS_ENABLED=false
DIAGNOSTIC_MODE_ENABLED=false
ALLOW_MANUAL_PAYMENT_INGEST=false
ENABLE_PROVIDER_RAIL_MOCK=false

REFUND_EXECUTION_REQUIRES_DISTINCT_ACTOR=true
SETTLEMENT_UNRESOLVED_REVIEW_POLICY=block
SETTLEMENT_BLOCK_ON_UNRESOLVED_REVIEWS=true
PAYMENTS_DISABLED=true
MAX_ACTIVE_INVOICES_PER_RECIPIENT=1
MAX_INVOICE_AMOUNT_JPY=100000000
DAILY_STORE_AMOUNT_CAP_JPY=1000000000
DAILY_STORE_INVOICE_CAP=10000

LEGAL_GATE_APPROVED=true
LEGAL_GATE_APPROVAL_REF=<LEGAL-YYYY-MMDD-NNN>
AML_POLICY_APPROVED=true
AML_POLICY_APPROVAL_REF=<AML-YYYY-MMDD-NNN>
PRIVACY_POLICY_APPROVED=true
PRIVACY_POLICY_APPROVAL_REF=<PRIV-YYYY-MMDD-NNN>
APPI_POLICY_APPROVED=true
APPI_POLICY_APPROVAL_REF=<APPI-YYYY-MMDD-NNN>
APPI_RETENTION_POLICY_REF=<APPI-RETENTION-REF>
APPI_DELETION_PROCEDURE_REF=<APPI-DELETION-REF>
APPI_DISCLOSURE_PROCEDURE_REF=<APPI-DISCLOSURE-REF>
AML_HIGH_VALUE_THRESHOLD_JPY=300000

RELEASE_ID=01KVY31WWH28VKS1DN1QE3CZ7C
RELEASE_MANIFEST=docs/goal-closure/goal-closure-20260625T000500Z/RELEASE_MANIFEST.DRAFT.json
COMMERCIAL_EVIDENCE_DIR=<explicit-production-evidence-dir>
