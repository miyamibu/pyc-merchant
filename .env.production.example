APP_ENV=production
NODE_ENV=production
APP_PORT=4173
PORT=4173
# PC direct/tunnel hosting must bind the app to loopback. A container-only
# deployment may override this inside the isolated container, but must not
# publish the app port directly to the internet.
APP_BIND_HOST=127.0.0.1
# Final public origin for miyamibu.xyz. Keep all three identical before printing
# the fixed QR or exposing customer-facing payment URLs.
APP_HOST=https://pay.miyamibu.xyz
PAY_BASE_URL=https://pay.miyamibu.xyz
PUBLIC_BASE_URL=https://pay.miyamibu.xyz

# Required at deploy time. Leave empty in the example so production startup
# fails closed until the deployment system injects approved values.
APP_SECRET=
SERVICE_INGEST_SECRET=
METRICS_SECRET=

DB_PATH=./runtime/data/app.db
BACKUP_DIR=./runtime/backups
LOG_LEVEL=info

# Required if the production database is empty and bootstrap provisioning is used.
TERMINAL_CODE=
STAFF_PIN=
SECOND_ADMIN_PIN=
BOOTSTRAP_ADMIN_PIN=
BOOTSTRAP_TERMINAL_CODE=

# Chain/token policy
CHAIN_ID=137
ENABLED_PAYMENT_CHAIN_IDS=1,43114,137
TOKEN_CONTRACT=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29
TOKEN_SYMBOL=JPYC
RECIPIENT_ADDRESS=
TOKEN_DECIMALS=6
JPYC_BASE_UNIT_SCALE=1000000
APPROVED_JPYC_TOKEN_CONTRACT=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29
JPYC_CONTRACT_APPROVAL_REF=
REQUIRED_CONFIRMATIONS=
MIN_REQUIRED_CONFIRMATIONS=
CONFIRMATIONS_POLICY_APPROVAL_REF=
MONITOR_BACKSCAN_BLOCKS=
MIN_MONITOR_BACKSCAN_BLOCKS=
BACKSCAN_POLICY_APPROVAL_REF=
CHECKOUT_SESSION_IMPLEMENTED=true

# Public signature/rate-limit/session
PUBLIC_LINK_GRACE_SEC=86400
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
SESSION_TTL_SEC=43200
TRUST_PROXY=true
# Required when TRUST_PROXY=true: the number of trusted reverse-proxy hops.
# Keep this at 1 for the nginx/Caddy -> app topology.
TRUST_PROXY_HOPS=1
TRUST_PROXY_CIDRS=
CORS_ALLOW_ORIGINS=https://pay.miyamibu.xyz
SERVICE_INGEST_ID=chain-monitor
SERVICE_AUTH_MAX_SKEW_SEC=300
SERVICE_AUTH_MAX_FUTURE_SEC=30
SERVICE_REPLAY_GUARD_TTL_SEC=86400
IDEMPOTENCY_TTL_SEC=604800
PIN_LOCKOUT_MAX_ATTEMPTS=5
PIN_LOCKOUT_SEC=900
WORKER_STALE_SEC=180
SSE_TOKEN_MAX_TTL_SEC=900

# Wallet adapter / simulation
WALLET_ADAPTER_TYPE=reown
ENABLE_REOWN=true
REOWN_PROJECT_ID=
WALLET_HELP_URL=https://walletconnect.com/
WALLET_DEEPLINK_TEMPLATE=
HASHPORT_WALLET_DEEPLINK_TEMPLATE=
SUPPORTED_WALLETS=HashPort Wallet,WalletConnect,Injected Wallet
COMMERCIAL_GO_MODE=false
DIAGNOSTIC_MODE_ENABLED=false
DIAGNOSTIC_MODE_APPROVAL_REF=
ENABLE_PUBLIC_PAYMENT_SIMULATION=false
DEMO_CONTROLS_ENABLED=false
ALLOW_MANUAL_PAYMENT_INGEST=false
MANUAL_INGEST_APPROVAL_REF=
ENABLE_PROVIDER_RAIL_MOCK=false

# Settlement/refund/invoice controls
REFUND_EXECUTION_REQUIRES_DISTINCT_ACTOR=true
SETTLEMENT_UNRESOLVED_REVIEW_POLICY=block
# Backward-compatible legacy flag. Keep aligned with
# SETTLEMENT_UNRESOLVED_REVIEW_POLICY=block until legacy references are removed.
SETTLEMENT_BLOCK_ON_UNRESOLVED_REVIEWS=true
PAYMENTS_DISABLED=true
MAX_ACTIVE_INVOICES_PER_RECIPIENT=1
MAX_INVOICE_AMOUNT_JPY=100000000
DAILY_STORE_AMOUNT_CAP_JPY=1000000000
DAILY_STORE_INVOICE_CAP=10000

# Legal / AML / privacy / APPI runtime gates
LEGAL_GATE_APPROVED=true
LEGAL_GATE_APPROVAL_REF=
AML_POLICY_APPROVED=true
AML_POLICY_APPROVAL_REF=
PRIVACY_POLICY_APPROVED=true
PRIVACY_POLICY_APPROVAL_REF=
APPI_POLICY_APPROVED=true
APPI_POLICY_APPROVAL_REF=
APPI_RETENTION_POLICY_REF=
APPI_DELETION_PROCEDURE_REF=
APPI_DISCLOSURE_PROCEDURE_REF=
AML_HIGH_VALUE_THRESHOLD_JPY=300000

# Chain monitor worker settings
RPC_URLS=
RPC_URLS_1=
RPC_URLS_43114=
RPC_URLS_137=
MONITOR_POLL_INTERVAL_MS=15000
MONITOR_DEAD_LETTER_MAX_RETRIES=5
MONITOR_DEAD_LETTER_RETRY_INTERVAL_MS=60000
