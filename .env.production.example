APP_ENV=production
NODE_ENV=production
# Deployment images are supplied by the release pipeline. Both references must
# include an immutable registry digest; tags and local image names are rejected.
APP_IMAGE_REF=
NGINX_IMAGE_REF=
APP_PORT=4173
PORT=4173
# PC direct/tunnel hosting must bind the app to loopback. A container-only
# deployment may override this inside the isolated container, but must not
# publish the app port directly to the internet.
APP_BIND_HOST=127.0.0.1
# Final public origin for miyamibu.xyz. Keep all three identical before printing
# the fixed QR or exposing customer-facing payment URLs.
APP_HOST=https://pay.miyamibu.xyz
PAY_BASE_URL=https://pay.miyamibu.xyz
PUBLIC_BASE_URL=https://pay.miyamibu.xyz

# Required at deploy time. Leave empty in the example so production startup
# fails closed until the deployment system injects approved values.
APP_SECRET=
# Required at deployment: active and verify-only receipt keys, e.g.
# receipt-2026-07=<random-secret>,receipt-2026-06=<previous-secret>
PAYMENT_RECEIPT_ACTIVE_KID=receipt-2026-07
PAYMENT_RECEIPT_KEY_RING=
PAYMENT_RECEIPT_VERIFY_ONLY_KIDS=
SERVICE_INGEST_SECRET=
METRICS_SECRET=

DB_PATH=./runtime/data/app.db
# Must point to a worker-only SQLite file; never reuse DB_PATH.
WORKER_STATE_DB_PATH=./runtime/worker-state/chain-137.db
BACKUP_DIR=./runtime/backups
LOG_LEVEL=info

# Required if the production database is empty and bootstrap provisioning is used.
TERMINAL_CODE=
STAFF_PIN=
SECOND_ADMIN_PIN=
BOOTSTRAP_ADMIN_PIN=
BOOTSTRAP_TERMINAL_CODE=

# Chain/token policy
CHAIN_ID=137
# Keep the pilot single-chain until each additional chain has its own worker,
# RPC readiness, policy approval, and release evidence.
ENABLED_PAYMENT_CHAIN_IDS=137
TOKEN_CONTRACT=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29
TOKEN_SYMBOL=JPYC
RECIPIENT_ADDRESS=
# On-chain ERC-20 atomic unit is separate from the internal accounting ledger.
TOKEN_DECIMALS=18
LEDGER_DECIMALS=6
LEDGER_BASE_UNIT_SCALE=1000000
APPROVED_JPYC_TOKEN_CONTRACT=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29
JPYC_CONTRACT_APPROVAL_REF=
# Optional approved metadata pins. Do not invent values: populate only from an
# independently reviewed Polygon RPC / explorer approval record.
APPROVED_TOKEN_NAME=
APPROVED_TOKEN_CODE_HASH=
APPROVED_TOKEN_IMPLEMENTATION_CODE_HASH=
DETECTION_CONFIRMATIONS=0
FULFILLMENT_REQUIRED_CONFIRMATIONS=
ACCOUNTING_FINALITY_CONFIRMATIONS=
# Legacy alias; keep equal to FULFILLMENT_REQUIRED_CONFIRMATIONS during migration.
REQUIRED_CONFIRMATIONS=
MIN_REQUIRED_CONFIRMATIONS=
CONFIRMATIONS_POLICY_APPROVAL_REF=
MONITOR_BACKSCAN_BLOCKS=
MIN_MONITOR_BACKSCAN_BLOCKS=
BACKSCAN_POLICY_APPROVAL_REF=
CHECKOUT_SESSION_IMPLEMENTED=true

# Public signature/rate-limit/session
PUBLIC_LINK_GRACE_SEC=86400
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
SESSION_TTL_SEC=43200
TRUST_PROXY=true
# Required when TRUST_PROXY=true: the number of trusted reverse-proxy hops.
# Keep this at 1 for the nginx/Caddy -> app topology.
TRUST_PROXY_HOPS=1
TRUST_PROXY_CIDRS=
CORS_ALLOW_ORIGINS=https://pay.miyamibu.xyz
SERVICE_INGEST_ID=chain-monitor
SERVICE_AUTH_MAX_SKEW_SEC=300
SERVICE_AUTH_MAX_FUTURE_SEC=30
SERVICE_REPLAY_GUARD_TTL_SEC=86400
IDEMPOTENCY_TTL_SEC=604800
PIN_LOCKOUT_MAX_ATTEMPTS=5
PIN_LOCKOUT_SEC=900
WORKER_STALE_SEC=180
SSE_TOKEN_MAX_TTL_SEC=900

# Wallet adapter / simulation
# This repository currently implements a configured wallet deeplink/EIP-681
# handoff, not a Reown AppKit session. Do not label the handoff as Reown.
WALLET_ADAPTER_TYPE=wallet_deeplink
ENABLE_REOWN=false
REOWN_PROJECT_ID=
WALLET_HELP_URL=https://walletconnect.com/
WALLET_DEEPLINK_TEMPLATE=
HASHPORT_WALLET_DEEPLINK_TEMPLATE=
WALLET_ADAPTER_ID=
# JSON registry entry must be supplied by the release owner; blank keeps startup fail-closed.
WALLET_ADAPTER_REGISTRY_JSON=
SUPPORTED_WALLETS=HashPort Wallet,WalletConnect,Injected Wallet
COMMERCIAL_GO_MODE=false
DIAGNOSTIC_MODE_ENABLED=false
DIAGNOSTIC_MODE_APPROVAL_REF=
ENABLE_PUBLIC_PAYMENT_SIMULATION=false
DEMO_CONTROLS_ENABLED=false
ALLOW_MANUAL_PAYMENT_INGEST=false
MANUAL_INGEST_APPROVAL_REF=
ENABLE_PROVIDER_RAIL_MOCK=false

# Settlement/refund/invoice controls
REFUND_EXECUTION_REQUIRES_DISTINCT_ACTOR=true
SETTLEMENT_UNRESOLVED_REVIEW_POLICY=block
# Backward-compatible legacy flag. Keep aligned with
# SETTLEMENT_UNRESOLVED_REVIEW_POLICY=block until legacy references are removed.
SETTLEMENT_BLOCK_ON_UNRESOLVED_REVIEWS=true
PAYMENTS_DISABLED=true
MAX_ACTIVE_INVOICES_PER_RECIPIENT=1
MAX_INVOICE_AMOUNT_JPY=100000000
DAILY_STORE_AMOUNT_CAP_JPY=1000000000
DAILY_STORE_INVOICE_CAP=10000

# Legal / AML / privacy / APPI runtime gates
LEGAL_GATE_APPROVED=false
LEGAL_GATE_APPROVAL_REF=
AML_POLICY_APPROVED=false
AML_POLICY_APPROVAL_REF=
PRIVACY_POLICY_APPROVED=false
PRIVACY_POLICY_APPROVAL_REF=
APPI_POLICY_APPROVED=false
APPI_POLICY_APPROVAL_REF=
APPI_RETENTION_POLICY_REF=
APPI_DELETION_PROCEDURE_REF=
APPI_DISCLOSURE_PROCEDURE_REF=
AML_HIGH_VALUE_THRESHOLD_JPY=300000

# Chain monitor worker settings
RPC_URLS=
RPC_URLS_1=
RPC_URLS_43114=
RPC_URLS_137=
MONITOR_POLL_INTERVAL_MS=15000
MONITOR_DEAD_LETTER_MAX_RETRIES=5
MONITOR_DEAD_LETTER_RETRY_INTERVAL_MS=60000
MONITOR_LOG_CHUNK_SIZE=1000
INTERNAL_APP_ORIGIN=http://app:4173

# Release and runtime fail-closed controls. Inject approved values at deploy
# time; do not copy these examples into a real-money environment unchanged.
DEPLOYMENT_STAGE=pilot
COMMERCIAL_EVIDENCE_ROOT=./docs/production/evidence
COMMERCIAL_EVIDENCE_DIR=
RELEASE_ID=
RELEASE_MODE=limited
RELEASE_MANIFEST=artifacts/release/<release-id>/RELEASE_MANIFEST.json
RELEASE_ENVIRONMENT_ID=
RELEASE_TRUSTED_PUBLIC_KEY_PATHS=artifacts/release/trusted/release-signing-key.pub.pem
RELEASE_REVOKED_KEY_IDS=
RELEASE_SIGNER_REGISTRY_JSON=[]
EVIDENCE_TRUSTED_PUBLIC_KEY_PATHS=artifacts/release/trusted/evidence-signing-key.pub.pem
EVIDENCE_REVOKED_KEY_IDS=
EVIDENCE_SIGNER_REGISTRY_JSON=[]
APPROVAL_TRUSTED_PUBLIC_KEY_PATHS=artifacts/release/trusted/approval-signing-keys.pub.pem
APPROVAL_REVOKED_KEY_IDS=
APPROVAL_SIGNER_REGISTRY_JSON=[]
# Limited mode is closed until all three deployment values are positive and no
# greater than the release-scoped signed limited_pilot_cap approval.
LIMITED_PILOT_MAX_TOTAL_VOLUME_JPYC_BASE=
LIMITED_PILOT_MAX_TRANSACTION_AMOUNT_JPYC_BASE=
LIMITED_PILOT_MAX_TRANSACTIONS=
REFUND_TREASURY_ADDRESS=
REFUND_TREASURY_APPROVAL_REF=
