{
  "name": "jpyc-terminal-production",
  "version": "1.0.0",
  "description": "JPYC terminal production-grade local implementation",
  "type": "module",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "monitor": "node src/chain-monitor.mjs",
    "check": "node --check src/server.mjs && node --check src/chain-monitor.mjs && node --check scripts/smoke-test.mjs && node --check scripts/verify-audit-chain.mjs && node --check scripts/ci/verify-github-actions-run.mjs && node --check scripts/production-validation/validate-production-config.mjs && node --check scripts/production-validation/validate-evidence-sanitization.mjs && node --check scripts/production-validation/validate-dependency-docker-hygiene.mjs && node --check scripts/production-validation/validate-commercial-evidence.mjs && node --check scripts/production-validation/validate-commercial-scorecard.mjs && node --check scripts/production-validation/validate-commercial-go.mjs && node --check scripts/production-validation/run-commercial-validate-safe.mjs && node --check scripts/production-validation/generate-settlement-evidence-pack.mjs && npm run security:destructive",
    "audit": "npm audit --audit-level=high",
    "security:destructive": "node scripts/security/check-destructive-ops.mjs",
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:serial": "node --test --test-concurrency=1 'tests/**/*.test.mjs'",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:audit-chain": "node scripts/verify-audit-chain.mjs",
    "deploy:check": "bash scripts/deploy/check.sh",
    "deploy:pc:preflight": "bash scripts/deploy/preflight-pc-hosting.sh",
    "deploy:public-host:check": "bash scripts/deploy/check-public-host.sh",
    "production:validate": "bash scripts/production-validation/run-all.sh",
    "commercial:report": "node scripts/production-validation/run-commercial-validate-safe.mjs",
    "commercial:gate": "node scripts/production-validation/run-commercial-validate-safe.mjs --enforce",
    "limited:gate": "node scripts/production-validation/run-commercial-validate-safe.mjs --limited-enforce",
    "commercial:validate": "node scripts/production-validation/validate-commercial-go.mjs",
    "commercial:validate:safe": "node scripts/production-validation/run-commercial-validate-safe.mjs",
    "production:validate:env": "bash scripts/production-validation/validate-production-env.sh",
    "evidence:collect": "bash scripts/production-validation/collect-evidence.sh",
    "evidence:device:prepare": "bash scripts/production-validation/prepare-device-diagnostics-evidence.sh",
    "evidence:external:prepare": "bash scripts/production-validation/prepare-external-validation-evidence.sh",
    "ci:verify:github": "node scripts/ci/verify-github-actions-run.mjs",
    "hygiene:deps-docker": "node scripts/production-validation/validate-dependency-docker-hygiene.mjs",
    "backup:sqlite": "bash scripts/deploy/backup-sqlite.sh",
    "restore:drill": "bash scripts/deploy/restore-drill.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "ethers": "^6.15.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "luxon": "^3.5.0",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^1.4.4"
  }
}
